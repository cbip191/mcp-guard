{
  "name": "@4sails/mcp-guard",
  "version": "0.2.0",
  "description": "Zero-dependency bidirectional MCP firewall, secret/PII DLP proxy, ACL gate, and prompt-injection quarantine middleware for Claude Code, Cursor, and B2B AI agents.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs"
    }
  },
  "bin": {
    "mcp-guard": "./bin/mcp-guard.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node ./scripts/check.mjs",
    "test": "node ./scripts/test.mjs",
    "demo": "node ./bin/mcp-guard.mjs demo",
    "prepublishOnly": "npm run check && npm test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "firewall",
    "dlp",
    "claude-code",
    "cursor",
    "secret-scanning",
    "pii-redaction",
    "acl",
    "prompt-injection",
    "jira",
    "slack",
    "4sails"
  ],
  "author": "Mykola Mishchenko <hello@4sails.tech> (https://4sails.tech)",
  "homepage": "https://4sails.tech/open-source/mcp-guard",
  "bugs": {
    "url": "https://github.com/cbip191/mcp-guard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbip191/mcp-guard.git"
  }
}
